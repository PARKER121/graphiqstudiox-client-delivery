# Application URLs
APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Admin Authentication
ADMIN_PASSWORD="your-secure-admin-password-here"
ADMIN_SESSION_SECRET="your-random-secret-key-here"

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Paystack (Payments)
PAYSTACK_SECRET_KEY="sk_live_your-secret-key-here"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_your-public-key-here"

# UploadThing (File Storage)
UPLOADTHING_TOKEN="your-uploadthing-token-here"
UPLOADTHING_SECRET="sk_live_your-secret-key-here"
UPLOADTHING_APP_ID="your-app-id-here"
UPLOADTHING_FILE_ACL="public-read"

# Cloudinary (Preview Images)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
